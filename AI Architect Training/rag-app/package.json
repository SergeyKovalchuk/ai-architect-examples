{
  "name": "rag-doc-analyzer",
  "version": "1.0.0",
  "description": "TypeScript RAG app (Vercel AI SDK + Azure/DIAL): analyze PDFs, extract & visualize data, ACL-aware retrieval, multimodal ingestion, and evaluation.",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "eval": "tsx src/eval.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "demo": "tsx src/ingest.ts && tsx src/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@fastify/static": "^8.0.0",
    "ai": "^7.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "pdfjs-dist": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
