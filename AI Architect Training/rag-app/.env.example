# ── Provider selection ───────────────────────────────────────────────
# PROVIDER = azure | dial | mock
#   azure : Azure OpenAI               dial : EPAM DIAL (OpenAI-compatible)
#   mock  : offline deterministic mode (no keys; for local demo & CI)
PROVIDER=mock

# ── Azure OpenAI ─────────────────────────────────────────────────────
AZURE_RESOURCE_NAME=your-resource
AZURE_API_KEY=your-azure-key
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_VISION_DEPLOYMENT=gpt-4o

# ── EPAM DIAL (OpenAI-compatible endpoint) ───────────────────────────
DIAL_BASE_URL=https://ai-proxy.lab.epam.com
DIAL_API_KEY=your-dial-key
DIAL_CHAT_MODEL=gpt-4o-mini
DIAL_EMBED_MODEL=text-embedding-3-small-1
DIAL_VISION_MODEL=gpt-4o

# ── Retrieval settings ───────────────────────────────────────────────
TOP_K=3
CHUNK_SIZE=320
CHUNK_OVERLAP=60
