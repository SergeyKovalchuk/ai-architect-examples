# PROVIDER = azure | dial | mock   (mock = offline, no API key)
PROVIDER=mock

# Offline data for the MCP servers (no network). 1 = canned data, 0 = live APIs.
OFFLINE=1

# Azure OpenAI
AZURE_RESOURCE_NAME=your-resource
AZURE_API_KEY=your-key
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini

# EPAM DIAL (OpenAI-compatible)
DIAL_BASE_URL=https://ai-proxy.lab.epam.com
DIAL_API_KEY=your-key
DIAL_CHAT_MODEL=gpt-4o-mini
