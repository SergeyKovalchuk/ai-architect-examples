PROVIDER=mock
OFFLINE=1
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
DIAL_BASE_URL=https://your-openai-compatible-gateway.example.com
DIAL_API_KEY=
DIAL_API_VERSION=2024-02-15-preview
DIAL_CHAT_MODEL=gpt-4.1-mini-2025-04-14
DIAL_EMBED_MODEL=text-embedding-3-small-1

# --- Auth & ACL ---
# Bearer-token auth is ON by default. Dev tokens: player-token / official-token / admin-token.
# Override in production with a JSON map: {"<token>":{"name":"...","roles":["..."]}}
# AUTH_TOKENS=
# AUTH_DISABLED=1   # set to disable auth (NOT for production)

# --- Abuse / cost controls (LLM10) ---
RATE_PER_MIN=30          # requests/min per token-or-IP (429 when exceeded)
MAX_QUESTION_CHARS=1000  # reject longer questions (400)
BODY_LIMIT_BYTES=32768   # max request body size
MAX_STEPS=6              # bounded agent tool-call loop
MAX_OUTPUT_TOKENS=800    # cap model output per answer
# CORS_ORIGINS=          # comma-separated allowlist; empty = same-origin only (locked down)

# --- Audit & observability ---
# OBSERVABILITY=1        # forward audit records to a wired sink (Langfuse / OpenTelemetry)
#                        # audit JSON lines are always written to stdout (ship to Loki/Datadog)
